#!/usr/bin/env bash
#
# wifideck — open the WiFiDeck app.
#
#   * If the installed systemd service is running, just opens the browser.
#   * Otherwise starts the backend + frontend dev servers and opens the browser.
#     Ctrl+C stops both.
#
# Options (env):
#   WIFIDECK_MOCK=1     run with fixtures, no adapter needed
#   WIFIDECK_TOKEN=...  API token (default: dev-token-change-me)
#   WIFIDECK_SUDO=1     run the backend as root so mode-switch / capture /
#                       deauth / sharing work (sudo prompts once)
#   WIFIDECK_ENABLE_ACTIVE=1  enable the gated offensive modules (deauth, guided
#                       capture) — authorized testing of your OWN networks only;
#                       each action still needs an in-scope target + confirmation
#
set -euo pipefail
ROOT="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
TOKEN="${WIFIDECK_TOKEN:-dev-token-change-me}"
MOCK="${WIFIDECK_MOCK:-0}"

SUDO=""
if [ "${WIFIDECK_SUDO:-0}" = "1" ]; then
  SUDO="sudo"
  echo "→ backend will run as root (WIFIDECK_SUDO=1); sudo may prompt for your password"
fi

open_url() { (xdg-open "$1" >/dev/null 2>&1 || sensible-browser "$1" >/dev/null 2>&1 || echo "  open $1 in your browser") & }

# 1. Production: the service is already running -> just open it.
if systemctl is-active --quiet wifideck 2>/dev/null; then
  echo "wifideck service is running — opening http://127.0.0.1:8787"
  open_url "http://127.0.0.1:8787"
  exit 0
fi

# 2. Dev: start backend + frontend.
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh" >/dev/null 2>&1 || true
if ! command -v npm >/dev/null 2>&1; then
  echo "ERROR: Node/npm not found. Install Node 18+ (nvm recommended) for the frontend." >&2
  exit 1
fi

pids=()
cleanup() {
  echo; echo "stopping WiFiDeck…"
  kill "${pids[@]}" 2>/dev/null || true
  # a sudo'd backend runs as root, so reap it explicitly
  [ -n "$SUDO" ] && $SUDO pkill -f "uvicorn app.main:app --host 127.0.0.1 --port 8787" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

# forward every WIFIDECK_* var (mock/token + WIFIDECK_ENABLE_ACTIVE, WIFIDECK_WATCHDOG,
# WIFIDECK_WIDS, WIFIDECK_WORDLIST, …) through to the backend, even under sudo.
export WIFIDECK_MOCK="$MOCK" WIFIDECK_TOKEN="$TOKEN"
WD_ENV=()
while IFS= read -r kv; do WD_ENV+=("$kv"); done < <(env | grep '^WIFIDECK_')

ACTIVE_NOTE=""
[ "${WIFIDECK_ENABLE_ACTIVE:-0}" = "1" ] && ACTIVE_NOTE=", active modules ON"
echo "→ backend  http://127.0.0.1:8787  (mock=$MOCK${SUDO:+, root}$ACTIVE_NOTE)"
( cd "$ROOT/backend" && $SUDO env "${WD_ENV[@]}" \
    PYTHONPATH=. python3 -m uvicorn app.main:app --host 127.0.0.1 --port 8787 ) &
pids+=($!)

echo "→ frontend http://localhost:5173"
( cd "$ROOT/frontend" && { [ -d node_modules ] || npm install; } && npm run dev ) &
pids+=($!)

# wait for the dev server, then open the browser
for _ in $(seq 1 80); do
  curl -s -o /dev/null "http://localhost:5173/" && break
  sleep 0.5
done
open_url "http://localhost:5173"
echo
echo "WiFiDeck is up → http://localhost:5173   (Ctrl+C to stop)"
wait
