#!/usr/bin/env bash
#
# wifi-monitor [channel] [interface]
#
# Switch the ALFA into MONITOR mode so you can capture raw 802.11 traffic and
# inject frames (airodump-ng, aireplay-ng, etc.).
#
# This is a ONE-WAY switch: it leaves MANAGED mode and STAYS in MONITOR mode.
# When you're done, run  wifi-managed  to go back to normal Wi-Fi + internet.
#
# Arguments (both optional, any order):
#   channel    a number, e.g. 6 (2.4GHz) or 36/149 (5GHz) — locks onto it
#   interface  a name like wlan0 — only needed if auto-detect picks the wrong one
#
# Examples:
#   wifi-monitor          # MONITOR mode, let airodump-ng hop channels
#   wifi-monitor 6        # MONITOR mode locked to channel 6
#
set -euo pipefail
SELF="$(readlink -f "$0")"
. "$(dirname "$SELF")/wifi-lib.sh"
become_root_if_needed "$@"

# --- Read arguments: a bare number is the channel, anything else is the iface.
CHANNEL=""
INTERFACE=""
for arg in "$@"; do
  if [[ "$arg" =~ ^[0-9]+$ ]]; then
    CHANNEL="$arg"
  else
    INTERFACE="$arg"
  fi
done
INTERFACE="$(pick_interface "$INTERFACE")"

echo "==> Switching $INTERFACE to MONITOR mode  (was: $(current_mode "$INTERFACE"))"

# 1. Take the interface away from NetworkManager so it stops managing/scanning it.
nmcli device set "$INTERFACE" managed no >/dev/null 2>&1 || true

# 2. Kill the background processes that hold the radio (wpa_supplicant, etc.).
#    airmon-ng does this cleanly; skip if it isn't installed.
if command -v airmon-ng >/dev/null 2>&1; then
  airmon-ng check kill >/dev/null 2>&1 || true
fi

# 3. Flip the radio type to monitor (must be done while the interface is down).
ip link set "$INTERFACE" down
iw dev "$INTERFACE" set type monitor
ip link set "$INTERFACE" up

# 4. Optionally lock onto one channel.
if [ -n "$CHANNEL" ]; then
  iw dev "$INTERFACE" set channel "$CHANNEL"
fi

echo "==> DONE. $INTERFACE is now in MONITOR mode${CHANNEL:+ on channel $CHANNEL}."
echo
echo "    Capture nearby networks (this hops channels for you):"
echo "        sudo airodump-ng $INTERFACE"
echo "    Go back to normal Wi-Fi + internet when finished:"
echo "        wifi-managed"
