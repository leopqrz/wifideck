#!/usr/bin/env bash
#
# wifi-share on|off [uplink] [downlink]
#
# Turn the Linux VM into a router so macOS can reach the internet THROUGH the
# ALFA's Wi-Fi connection.
#
#   macOS host  <--downlink (eth0, VMware NAT)--  [ VM ]  --uplink (wlan0, ALFA)-->  internet
#
# The ALFA must already be connected to a network in MANAGED mode (wifi-managed).
#
# Arguments:
#   on | off   turn sharing on or off
#   uplink     interface WITH internet — the ALFA   (default: auto-detected Wi-Fi)
#   downlink   interface facing the Mac             (default: eth0)
#
# NOTE: routing the Mac through the ALFA is usually SLOWER than the Mac's own
# Wi-Fi (VM + USB overhead). Use this when you specifically want the Mac on the
# ALFA's network — not as a speed boost.
#
set -euo pipefail
SELF="$(readlink -f "$0")"
. "$(dirname "$SELF")/wifi-lib.sh"
become_root_if_needed "$@"

ACTION="${1:-}"
UPLINK="${2:-$(find_wifi_interface)}"
DOWNLINK="${3:-eth0}"

turn_on() {
  if [ -z "$UPLINK" ]; then
    echo "ERROR: no uplink (Wi-Fi) interface. Connect the ALFA first: wifi-managed" >&2
    exit 1
  fi
  echo "==> Sharing internet:  Mac <--$DOWNLINK--[ VM ]--$UPLINK--> internet"

  # 1. Allow the kernel to forward packets between interfaces.
  sysctl -w net.ipv4.ip_forward=1 >/dev/null

  # 2. NAT: rewrite everything leaving via the ALFA so replies come back to us.
  #    Each rule is added only if it isn't already present (-C checks first).
  iptables -t nat -C POSTROUTING -o "$UPLINK" -j MASQUERADE 2>/dev/null \
    || iptables -t nat -A POSTROUTING -o "$UPLINK" -j MASQUERADE
  iptables -C FORWARD -i "$DOWNLINK" -o "$UPLINK" -j ACCEPT 2>/dev/null \
    || iptables -A FORWARD -i "$DOWNLINK" -o "$UPLINK" -j ACCEPT
  iptables -C FORWARD -i "$UPLINK" -o "$DOWNLINK" -m state --state RELATED,ESTABLISHED -j ACCEPT 2>/dev/null \
    || iptables -A FORWARD -i "$UPLINK" -o "$DOWNLINK" -m state --state RELATED,ESTABLISHED -j ACCEPT

  # 3. Make the ALFA the VM's preferred route out, so forwarded Mac traffic
  #    actually exits via Wi-Fi instead of looping back to the Mac.
  local gateway
  gateway="$(ip route show dev "$UPLINK" 2>/dev/null | awk '/default/{print $3; exit}')"
  [ -z "$gateway" ] && gateway="$(nmcli -g IP4.GATEWAY device show "$UPLINK" 2>/dev/null | head -1)"
  if [ -n "$gateway" ]; then
    ip route replace default via "$gateway" dev "$UPLINK" metric 50
    echo "    default route -> $gateway via $UPLINK"
  else
    echo "    WARNING: no gateway on $UPLINK — connect it to Wi-Fi first (wifi-managed)."
  fi

  local my_ip
  my_ip="$(ip -4 -o addr show "$DOWNLINK" 2>/dev/null | awk '{print $4}' | cut -d/ -f1)"
  echo "==> Sharing is ON. This VM's Mac-facing IP is: ${my_ip:-<unknown>}"
  echo
  echo "    Now on macOS (Terminal), point traffic at this VM:"
  echo "        sudo route -n add -net 0.0.0.0/1   ${my_ip:-<VM-IP>}"
  echo "        sudo route -n add -net 128.0.0.0/1 ${my_ip:-<VM-IP>}"
  echo "        networksetup -setdnsservers Wi-Fi 1.1.1.1"
  echo "    (the two /1 routes override the Mac's default without deleting it)"
}

turn_off() {
  echo "==> Turning internet sharing OFF."
  iptables -t nat -D POSTROUTING -o "$UPLINK" -j MASQUERADE 2>/dev/null || true
  iptables -D FORWARD -i "$DOWNLINK" -o "$UPLINK" -j ACCEPT 2>/dev/null || true
  iptables -D FORWARD -i "$UPLINK" -o "$DOWNLINK" -m state --state RELATED,ESTABLISHED -j ACCEPT 2>/dev/null || true
  sysctl -w net.ipv4.ip_forward=0 >/dev/null
  echo "==> Sharing is OFF. On macOS, undo the routes:"
  echo "        sudo route -n delete -net 0.0.0.0/1"
  echo "        sudo route -n delete -net 128.0.0.0/1"
  echo "        networksetup -setdnsservers Wi-Fi Empty"
}

case "$ACTION" in
  on)  turn_on ;;
  off) turn_off ;;
  *)   echo "usage: wifi-share on|off [uplink] [downlink]" >&2; exit 1 ;;
esac
