#!/usr/bin/env bash
#
# wifi-status
#
# Quick health check of the ALFA: is it plugged in, which driver is loaded,
# is it in MANAGED or MONITOR mode, and is it connected?
# Read-only — it changes nothing, so no root needed.
#
# No 'set -e' here on purpose: this is a reporter, and any single info source
# (e.g. NetworkManager, which is stopped while in MONITOR mode) may be missing.
# A failure to read one line should never abort the whole report.
set -uo pipefail
SELF="$(readlink -f "$0")"
. "$(dirname "$SELF")/wifi-lib.sh"

# --- 1. Is the adapter on the USB bus? ------------------------------------
echo "== USB adapter =="
if lsusb -d 0bda:8812 >/dev/null 2>&1; then
  lsusb -d 0bda:8812 | sed 's/^/  /'
else
  echo "  NOT PRESENT — the ALFA isn't reaching the VM."
  echo "  In VMware Fusion:  Virtual Machine > USB & Bluetooth > Connect AWUS036ACH"
fi

# --- 2. Which driver is bound? --------------------------------------------
echo "== Driver =="
if lsmod | grep -qE '^(rtw88_8812au|88XXau|8812au)'; then
  lsmod | grep -E '^(rtw88_8812au|88XXau|8812au)' | awk '{print "  "$1}'
else
  echo "  (no RTL8812AU driver loaded)"
fi

# --- 3. Interface + mode --------------------------------------------------
echo "== Interface =="
INTERFACE="$(find_wifi_interface)"
if [ -z "$INTERFACE" ]; then
  echo "  no Wi-Fi interface"
else
  echo "  device : $INTERFACE"
  echo "  mode   : $(current_mode "$INTERFACE")"
  echo "  link   : $(cat "/sys/class/net/$INTERFACE/operstate" 2>/dev/null)"

  # NetworkManager's view (connected SSID, etc.). NM is stopped in MONITOR mode,
  # so this is best-effort — never let it abort the report.
  if systemctl is-active NetworkManager >/dev/null 2>&1; then
    nmcli -t -f DEVICE,STATE,CONNECTION device 2>/dev/null \
      | awk -F: -v d="$INTERFACE" '$1==d {print "  network: "$2" ("$3")"}' || true
  else
    echo "  network: (NetworkManager stopped — normal in MONITOR mode)"
  fi

  # IP address, if any
  ip -br addr show "$INTERFACE" 2>/dev/null | sed 's/^/  ip     : /' || true
fi

# --- 4. Nearby networks ----------------------------------------------------
# Only possible in MANAGED mode with NetworkManager up; MONITOR mode can't scan
# this way (use airodump-ng for that).
echo "== Nearby networks =="
if [ -n "$INTERFACE" ] \
   && [ "$(current_mode "$INTERFACE")" = "MANAGED" ] \
   && systemctl is-active NetworkManager >/dev/null 2>&1; then
  # IN-USE (*) marks the one you're connected to; sorted strongest-first.
  nmcli -f IN-USE,SIGNAL,CHAN,SSID,SECURITY device wifi list --rescan yes 2>/dev/null \
    | sed 's/^/  /' \
    || echo "  (scan failed)"
else
  echo "  (unavailable — needs MANAGED mode + NetworkManager)"
  echo "  run 'wifi-managed' for a scan here, or 'airodump-ng $INTERFACE' in MONITOR mode"
fi
