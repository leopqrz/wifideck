#!/usr/bin/env bash
#
# wifi-managed [interface]
#
# Switch the ALFA back into MANAGED mode — normal Wi-Fi. It hands the interface
# back to NetworkManager, which reconnects to your known networks and restores
# internet. This is the counterpart to  wifi-monitor.
#
# Argument (optional):
#   interface  a name like wlan0 — only needed if auto-detect picks the wrong one
#
set -euo pipefail
SELF="$(readlink -f "$0")"
. "$(dirname "$SELF")/wifi-lib.sh"
become_root_if_needed "$@"

INTERFACE="$(pick_interface "${1:-}")"

echo "==> Switching $INTERFACE to MANAGED mode  (was: $(current_mode "$INTERFACE"))"

# 1. Flip the radio type back to managed (done while the interface is down).
ip link set "$INTERFACE" down
iw dev "$INTERFACE" set type managed
ip link set "$INTERFACE" up

# 2. Give the interface back to NetworkManager.
nmcli device set "$INTERFACE" managed yes >/dev/null 2>&1 || true

# 3. Restart NetworkManager so wpa_supplicant (killed for MONITOR mode) returns,
#    then let it reconnect to a known network.
systemctl restart NetworkManager >/dev/null 2>&1 || true
sleep 2
nmcli device connect "$INTERFACE" >/dev/null 2>&1 || true

echo "==> DONE. $INTERFACE is back in MANAGED mode and handed to NetworkManager."
echo
echo "    See available networks:   nmcli device wifi list"
echo "    Connect to one:           nmcli device wifi connect \"SSID\" password \"PASS\""
