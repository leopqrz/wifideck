# Copy to .env and edit. The systemd unit reads this file.

# Loopback only — do not change unless you fully understand the exposure.
WIFIDECK_HOST=127.0.0.1
WIFIDECK_PORT=8787

# REQUIRED: set a real secret. Generate one with:  openssl rand -hex 24
WIFIDECK_TOKEN=dev-token-change-me

# 1 = serve recorded fixtures instead of touching hardware (no ALFA needed).
WIFIDECK_MOCK=0

# Active (transmit) modules — deauth. OFF by default. Enable ONLY for authorized
# testing of networks you own. Even when enabled, each action still requires the
# target to be in the scope allowlist AND an explicit per-action authorization.
WIFIDECK_ENABLE_ACTIVE=0
WIFIDECK_SCOPE_FILE=/tmp/wifideck/scope.json
WIFIDECK_AUDIT_LOG=/tmp/wifideck/audit.jsonl

# Self-healing watchdog: detect -71 USB drops and auto-recover (driver reload,
# USB reset, reconnect). Needs root. Off by default; toggle live in the UI too.
WIFIDECK_WATCHDOG=0
WIFIDECK_WATCHDOG_INTERVAL=5
