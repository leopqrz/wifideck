# Copy to .env and edit. The systemd unit reads this file.

# Loopback only — do not change unless you fully understand the exposure.
WIFIDECK_HOST=127.0.0.1
WIFIDECK_PORT=8787

# REQUIRED: set a real secret. Generate one with:  openssl rand -hex 24
WIFIDECK_TOKEN=dev-token-change-me

# 1 = serve recorded fixtures instead of touching hardware (no ALFA needed).
WIFIDECK_MOCK=0
